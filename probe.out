<script type="module" dynamic>
  const configUrl = "/a/elevar/static/configs/c5e2d9cc748809e154ea8a183bf2b279a7353ab1/config.js";
  const config = (await import(configUrl)).default;
  const scriptUrl = config.script_src_app_theme_embed;

  if (scriptUrl) {
    const { handler } = await import(scriptUrl);

    const readDomLiquidSnippet = id => {
      const element = document.querySelector(`#${id}`);
      return JSON.parse(element?.textContent ?? "null");
    };

    const stripNullProperties = object => {
      return Object.fromEntries(
        Object.entries(object).filter(([_k, v]) => v !== null)
      );
    };

    const getLiquidSnippetsFromDom = () => {
      const cartData = readDomLiquidSnippet("elevar-cart-data");
      const user = readDomLiquidSnippet("elevar-user");
        
      return {
        cartData,
        user: { ...user, customer: stripNullProperties(user.customer) },
        isOnCartPage: cartData.isOnCartPage,
        collectionView: readDomLiquidSnippet("elevar-collection-view"),
