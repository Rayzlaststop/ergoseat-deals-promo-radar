      ImageURL: "https://www.xchair.com/cdn/shop/products/2020_XChair_x3_Glacier_ATR_Headrest_NoHMT_02_Front_Right_R1_grande.png?v=1682282931",
      URL: "https://www.xchair.com/products/x3-atr-management-office-chair",
