<section
  class="product-dimensions  product-dimensions--mobile"
  data-product-dimensions
  v-if="!loading && height && width && depth"
  v-cloak
>
  


  <header class="section-heading">
    <div class="section-heading__column section-heading__column--content">
      
        <h2><span>Dimensions.</span></h2>
      
      
      
    </div>

    
    <div class="section-heading__column section-heading__column--cta is-showtime">
      
        <div class="section-heading__buttons">
          <button
            type="button"
            class="section-heading__button section-heading__button--prev loading"
            data-product-dimensions-button="prev"
          >
            <svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" width="47px" height="47px" viewBox="0 0 47 47" xml:space="preserve">
	<circle fill="#ffffff" cx="23.5" cy="23.5" r="23.5"/>
	<polygon fill="#000000" points="26.03,31 28,29.067 22.2,23.268 28,17.468 26.03,15.534 18.33,23.267 "/>
</svg>

          </button>
          <button
            type="button"
            class="section-heading__button section-heading__button--next loading"
            data-product-dimensions-button="next"
          >
            <svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" width="47px" height="47px" viewBox="0 0 47 47" xml:space="preserve">
	<circle fill="#ffffff" cx="23.5" cy="23.5" r="23.5"/>
	<polygon fill="#000000" points="20.97,16 19,17.933 24.8,23.732 19,29.532 20.97,31.466 28.67,23.733 "/>
</svg>

          </button>
        </div>
      
    </div>
    
  </header>



  <div class="product-dimensions__container">

  
  
  
  
  

  

  
    <div class="product-dimensions__images-wrapper">
      <div class="swiper" data-product-dimensions-carousel>
        <div class="swiper-wrapper">
          <div class="product-dimensions__image product-dimensions__image--front swiper-slide">
            <div class="product-dimensions__measurements product-dimensions__measurements--front">
              <div class="product-dimensions__front product-dimensions__front--height" v-if="height">
                <div class="product-dimensions__text-wrapper product-dimensions__text-wrapper--height">
                  <div class="product-dimensions__front-line--height"></div>
                  <div class="product-dimensions__text-holder">
                    <div class="product-dimensions__text">Height</div>
                  </div>
                </div>
              </div>

              <div class="product-dimensions__front product-dimensions__front--combo">
                <img
                  src="https://cdn.accentuate.io/8115118604570/1686962852359/XC_X3_Lineart-02--optimized.svg?v=1686962852359"
                  class="product-dimensions__front-image"
                  alt="office chair front"
                  height="400"
                  width="181"
                  loading="lazy"
                />
              </div>
            </div>

            <div class="product-dimensions__front product-dimensions__front--bottom-wrapper" v-if="width || seat_width">
              <div class="product-dimensions__front product-dimensions__front--bottom is-width" v-if="width">
                <div class="product-dimensions__text-wrapper product-dimensions__text-wrapper--bottom">
                  <div class="product-dimensions__front-line"></div>
                  <div class="product-dimensions__text-holder">
                    <div class="product-dimensions__text">Width</div>
                  </div>
                </div>
              </div>

              <div class="product-dimensions__front product-dimensions__front--bottom is-seat-width" v-if="seat_width">
                <div class="product-dimensions__text-wrapper product-dimensions__text-wrapper--bottom">
                  <div class="product-dimensions__front-line"></div>
                  <div class="product-dimensions__text-holder">
                    <div class="product-dimensions__text">Seat Width</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="product-dimensions__image product-dimensions__image--side swiper-slide">
            <div class="product-dimensions__measurements product-dimensions__measurements--side">
              <div class="product-dimensions__side product-dimensions__side--combo">
                <img
                  src="https://cdn.accentuate.io/8115118604570/1686958735419/XC_X3_Lineart-03--optimized-1x.png?v=1686958735419"
                  class="product-dimensions__side-image"
                  alt="office chair side"
                  height="400"
                  width="193"
                  loading="lazy"
                />
              </div>

              <div class="product-dimensions__side product-dimensions__side--height" v-if="seat_height || armrest_height">
                <div class="product-dimensions__text-wrapper product-dimensions__text-wrapper--height is-armrest-height">
                  <div class="product-dimensions__side-line product-dimensions__side-line--height"></div>
                  <div class="product-dimensions__text-holder">
                    <div class="product-dimensions__text">Armrest<br>Height</div>
                  </div>
                </div>

                <div class="product-dimensions__text-wrapper product-dimensions__text-wrapper--height is-seat-height">
                  <div class="product-dimensions__side-line product-dimensions__side-line--height"></div>
                  <div class="product-dimensions__text-holder">
                    <div class="product-dimensions__text">Seat Height</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="product-dimensions__side product-dimensions__side--bottom-wrapper" v-if="depth">
              <div class="product-dimensions__side product-dimensions__side--depth" v-if="depth">
                  <div class="product-dimensions__text-wrapper product-dimensions__text-wrapper--depth">
                    <div class="product-dimensions__side-line product-dimensions__side-line--depth"></div>
                    <div class="product-dimensions__text-holder">
                      <div class="product-dimensions__text">Depth</div>
                    </div>
                  </div>
                </div>
            </div>
          </div>
        </div>
        
          <div class="swiper-pagination"></div>
        
      </div>
    </div>

    <ul class="product-dimensions__list">
      <li class="product-dimensions__item" v-if="height">
        <div class="product-dimensions__item-type">Height</div>
        <div class="product-dimensions__item-value">${ height }</div>
      </li>
      <li class="product-dimensions__item" v-if="width">
        <div class="product-dimensions__item-type">Width</div>
        <div class="product-dimensions__item-value">${ width }</div>
      </li>
      <li class="product-dimensions__item" v-if="depth">
        <div class="product-dimensions__item-type">Depth</div>
        <div class="product-dimensions__item-value">${ depth }</div>
      </li>
      <li class="product-dimensions__item" v-if="seat_height">
        <div class="product-dimensions__item-type">Seat Height</div>
        <div class="product-dimensions__item-value">${ seat_height }</div>
      </li>
      <li class="product-dimensions__item" v-if="seat_width">
        <div class="product-dimensions__item-type">Seat Width</div>
        <div class="product-dimensions__item-value">${ seat_width }</div>
      </li>
      <li class="product-dimensions__item" v-if="seat_depth">
        <div class="product-dimensions__item-type">Seat Depth</div>
        <div class="product-dimensions__item-value">${ seat_depth }</div>
      </li>
      <li class="product-dimensions__item" v-if="armrest_height">
        <div class="product-dimensions__item-type">Armrest Height</div>
        <div class="product-dimensions__item-value">${ armrest_height }</div>
      </li>
      <li class="product-dimensions__item" v-if="weight">
        <div class="product-dimensions__item-type">Weight</div>
        <div class="product-dimensions__item-value">${ weight }</div>
      </li>
      <li class="product-dimensions__item" v-if="weight_capacity">
        <div class="product-dimensions__item-type">Weight Capacity</div>
        <div class="product-dimensions__item-value">${ weight_capacity }</div>
      </li>
    </ul>
  
  </div>
</section>

