<script type="text/javascript" data-em-disable data-vsly>
    (()=> {
        const env = 2;
        var store = "xchair-us.myshopify.com";
        var alias = store.replace(".myshopify.com", "").replaceAll("-", "_").toUpperCase();
        var jitsuKey =  "js.66995585306";
        var themeId = 192041550106;
        var role = "main";
        window.loomi_ctx = {...(window.loomi_ctx || {}),storeAlias:alias,jitsuKey,env,themeId,role};
        
        
    
	
	var product = {};
	var variants = [];
	
	variants.push({id:44508921921818,policy:"continue",price:97900,iq:100});
	
	variants.push({id:44508921954586,policy:"continue",price:97900,iq:100});
	
	variants.push({id:44508921987354,policy:"continue",price:97900,iq:100});
	
	variants.push({id:44508922020122,policy:"continue",price:97900,iq:100});
	
	product.variants = variants;
	product.oos = !true;
	product.price = 97900 ;
	window.loomi_ctx.current_product=product;
	window.loomi_ctx.productId=8115118604570;
	window.loomi_ctx.variantId = 44508921921818;
	
        
        window.loomi_ctx.blockingConcent = false;
        loomi_ctx.ttl=1795256608;
        
        loomi_ctx.embedded_flags=["allow-embed-redirect-tests","is-debounce-init"];
    })()
</script>
